{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ralph Loop Workflow Schema",
  "type": "object",
  "description": "Schema for defining Ralph loop workflows in YAML",
  
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this workflow pattern"
    },
    
    "pattern_type": {
      "type": "string",
      "enum": ["single_agent", "multi_agent_sequential", "multi_agent_parallel", "hybrid", "custom"],
      "description": "Type of workflow pattern"
    },
    
    "workflow": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Workflow schema version"
        },
        
        "settings": {
          "$ref": "#/definitions/settings"
        },
        
        "loop": {
          "$ref": "#/definitions/agent_definition",
          "description": "Single agent loop (for pattern_type: single_agent)"
        },
        
        "plan": {
          "$ref": "#/definitions/agent_definition",
          "description": "Planning agent step"
        },
        
        "builders": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/agent_definition"
          },
          "description": "Multiple builder agents (for pattern_type: multi_agent)"
        },
        
        "verifiers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/agent_definition"
          },
          "description": "Multiple verifier agents"
        },
        
        "merge": {
          "$ref": "#/definitions/agent_definition",
          "description": "Merge agent for combining results"
        },
        
        "decide": {
          "$ref": "#/definitions/agent_definition",
          "description": "Decision agent for loop control"
        },
        
        "success": {
          "$ref": "#/definitions/success_definition",
          "description": "Success detection and reporting"
        },
        
        "on_failure": {
          "$ref": "#/definitions/failure_handling",
          "description": "What to do on failure"
        }
      }
    },
    
    "server": {
      "$ref": "#/definitions/server_config"
    },
    
    "logging": {
      "$ref": "#/definitions/logging_config"
    },
    
    "safety": {
      "$ref": "#/definitions/safety_config"
    }
  },
  
  "definitions": {
    "agent_definition": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "description": "Agent name"
        },
        "type": {
          "type": "string",
          "enum": ["primary", "subagent"],
          "description": "Primary or subagent type"
        },
        "model": {
          "type": "string",
          "description": "Model ID for this agent"
        },
        "task": {
          "type": "string",
          "description": "Task description/prompt for the agent"
        },
        "output_format": {
          "type": "string",
          "enum": ["text", "json", "markdown"],
          "description": "Expected output format"
        },
        "stop_condition": {
          "type": "string",
          "description": "Pattern to detect for stopping execution"
        },
        "parallel": {
          "type": "boolean",
          "description": "Whether this agent runs in parallel with others"
        },
        "depends_on": {
          "type": ["string", "array"],
          "items": { "type": "string" },
          "description": "Prerequisite step(s)"
        },
        "tools": {
          "type": "object",
          "properties": {
            "read": "boolean",
            "write": "boolean",
            "edit": "boolean",
            "bash": { "type": ["boolean", "array"] },
            "webfetch": "boolean",
            "question": "boolean"
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "file_edits": {
              "type": "string",
              "enum": ["allow", "ask", "deny"]
            },
            "bash_commands": {
              "type": "string",
              "enum": ["allow", "ask", "deny"]
            },
            "git_commands": {
              "type": "string",
              "enum": ["allow", "ask", "deny"]
            }
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum iterations before fallback"
        }
      }
    },
    
    "settings": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 20,
          "description": "Maximum loop iterations"
        },
        "stop_on_success": {
          "type": "boolean",
          "default": true,
          "description": "Stop when success condition is met"
        },
        "escape_hatch": {
          "type": "boolean",
          "default": true,
          "description": "Enable emergency stop mechanism"
        },
        "parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of parallel workers (for multi-agent)"
        }
      }
    },
    
    "success_definition": {
      "type": "object",
      "properties": {
        "detect": {
          "type": ["string", "array"],
          "items": { "type": "string" },
          "description": "Patterns to detect for success"
        },
        "verify": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Verification steps to run on success"
        },
        "report": {
          "type": "string",
          "description": "Success report template"
        }
      }
    },
    
    "failure_handling": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["retry", "stop", "fallback"],
          "description": "Action to take on failure"
        },
        "with_context": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Context to preserve for retry"
        }
      }
    },
    
    "server_config": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 4242
        },
        "auto_start": {
          "type": "boolean",
          "default": true
        },
        "web_ui": {
          "type": "boolean",
          "default": false
        }
      }
    },
    
    "logging_config": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info"
        },
        "save_conversations": {
          "type": "boolean",
          "default": true
        },
        "directory": {
          "type": "string",
          "default": "./ralph-logs"
        },
        "format": {
          "type": "string",
          "enum": ["json", "text"],
          "default": "json"
        }
      }
    },
    
    "safety_config": {
      "type": "object",
      "properties": {
        "sandbox": {
          "type": "boolean",
          "default": true
        },
        "max_runtime": {
          "type": "integer",
          "description": "Maximum runtime in seconds"
        },
        "requires_confirmation": {
          "type": "boolean",
          "default": false
        },
        "max_parallel_sessions": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum concurrent sessions"
        }
      }
    }
  },
  
  "required": ["description", "pattern_type", "workflow"]
}
